{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Tmdb": {
    "ApiKey": "",
    "BaseUrl": "https://api.themoviedb.org/3/",
    "DefaultLanguage": "en-US",
    "RequestTimeoutSeconds": 30,
    "MaxRetries": 3,
    "RetryBaseDelayMs": 500
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=movierater;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "MovieRaterApi",
    "Audience": "MovieRaterWeb",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SigningKey": "this-is-not-a-real-key-replace-in-production-with-at-least-32-chars"
  }
}
